{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "keplar-business": {
      "type": "streamable-http",
      "url": "https://business.keplar.one/api/chatgpt/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": [
              "business:read"
            ],
            "defaultScopes": [
              "business:read",
              "business:write"
            ]
          }
        }
      }
    }
  }
}
