0:{"buildId":"GlIYlslMjIW7c1eLMJOrI","data":[{"rsc":["$","$1","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://keplar.one/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Privacy\",\"item\":\"https://keplar.one/privacy\"}]}"}}],["$","div",null,{"className":"Legal-module__2dCIza__page","children":[["$","header",null,{"className":"Legal-module__2dCIza__header","children":[["$","p",null,{"className":"Legal-module__2dCIza__eyebrow","children":"Legal"}],["$","h1",null,{"className":"Legal-module__2dCIza__title","children":["Privacy at"," ",["$","span",null,{"className":"tt-g","children":"Keplar"}]]}],["$","p",null,{"className":"Legal-module__2dCIza__subline","children":"What Keplar collects, where it goes, and how to see or delete it."}],["$","p",null,{"className":"Legal-module__2dCIza__updated","children":["Last updated: ","October 12, 2026"]}]]}],["$","div",null,{"className":"Legal-module__2dCIza__status","role":"note","children":[["$","p",null,{"children":[["$","strong",null,{"children":"One detail is still to be added."}]," ","The founders have not yet supplied them, so they are marked below instead of guessed."]}],["$","a",null,{"href":"#review-1","className":"Legal-module__2dCIza__statusLink","children":"See what is missing"}]]}],["$","div",null,{"className":"Legal-module__2dCIza__layout","children":[["$","aside",null,{"className":"Legal-module__2dCIza__tocCol","children":["$","$L2",null,{"items":[{"id":"summary","title":"The short version"},{"id":"data-flow","title":"How a request moves through Keplar"},{"id":"information-you-provide","title":"Information you provide"},{"id":"account-information","title":"Account information"},{"id":"prompts-and-conversations","title":"Prompts and conversations"},{"id":"memory","title":"Saved chats and memory"},{"id":"files","title":"Files, study guides and slide decks"},{"id":"voice","title":"Voice dictation and voice mode (beta)"},{"id":"optional-learning","title":"Optional: Help improve Keplar and common questions"},{"id":"creation-media","title":"Images, video and creation tools"},{"id":"feedback-and-sharing","title":"Feedback and shared answer links"},{"id":"usage-information","title":"Usage information"},{"id":"device-information","title":"Device and connection information"},{"id":"cookies","title":"Cookies and local storage"},{"id":"payment-information","title":"Payment information"},{"id":"how-we-use-information","title":"How Keplar uses information"},{"id":"model-providers","title":"AI model providers"},{"id":"infrastructure-providers","title":"Infrastructure and service providers"},{"id":"sharing","title":"When else information is shared"},{"id":"retention","title":"How long data is kept"},{"id":"security","title":"Security"},{"id":"business-data","title":"Keplar Business and agents"},{"id":"teams-api-extension","title":"Team workspaces, API keys and the browser extension (beta)"},{"id":"international-processing","title":"International processing"},{"id":"your-rights","title":"Your rights and choices"},{"id":"children","title":"Children"},{"id":"changes","title":"Changes to this policy"},{"id":"contact","title":"Contact"}]}]}],["$","article",null,{"className":"Legal-module__2dCIza__body","children":[["$","div",null,{"className":"Legal-module__2dCIza__intro","children":[["$","p","Keplar sends your question to more than one AI model, compares what they say, and gives you one answer. That means your data moves through more systems than a single chatbot. This page explains which data is involved, where it goes, and the choices you have.",{"children":"Keplar sends your question to more than one AI model, compares what they say, and gives you one answer. That means your data moves through more systems than a single chatbot. This page explains which data is involved, where it goes, and the choices you have."}],"$L3"]}],["$L4","$L5","$L6","$L7","$L8","$L9","$La","$Lb","$Lc","$Ld","$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f"],"$L20"]}]]}]]}]],["$L21","$L22"],"$L23"]}],"isPartial":"$@24","staleTime":"$25","varyParams":null},{"rsc":"$L26","isPartial":"$@27","staleTime":"$25","varyParams":null},{"rsc":"$L28","isPartial":"$@29","staleTime":"$25","varyParams":"$2a"}],"isUpgradeableISRFallback":false,"a":"$@2b","rootVaryParams":null,"needsRuntimeRequest":"$@2c"}
