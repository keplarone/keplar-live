3:["$","p","It describes how Keplar works today. If that changes in a way that matters, we update this page and its date.",{"children":"It describes how Keplar works today. If that changes in a way that matters, we update this page and its date."}]
4:["$","section","summary",{"id":"summary","className":"Legal-module__2dCIza__section","aria-labelledby":"summary-h","data-still":true,"children":[["$","h2",null,{"id":"summary-h","className":"Legal-module__2dCIza__h2","children":[["$","span",null,{"className":"Legal-module__2dCIza__num","aria-hidden":"true","children":"01"}],["$","span",null,{"children":"The short version"}],["$","a",null,{"href":"#summary","className":"Legal-module__2dCIza__anchor","aria-label":"Link to The short version","children":"#"}]]}],[["$","ul","0",{"className":"Legal-module__2dCIza__list","children":[["$","li","Your prompts. When you ask a question, the text (and any image or video frames you attach) is sent to the AI model providers Keplar picks for that request. Not every provider, every time.",{"children":[["$","strong",null,{"children":"Your prompts."}]," ","When you ask a question, the text (and any image or video frames you attach) is sent to the AI model providers Keplar picks for that request. Not every provider, every time."]}],["$","li","Free is different. Free-plan questions run on free open models. Free model hosts may log prompts, and some may use them to improve their models. On Free, Keplar does not send your saved memory or the text of attached documents to those models, and no model learns new memory from your Free chats. Plus and Pro requests are sent only to endpoints that say they do not train on prompts.",{"children":[["$","strong",null,{"children":"Free is different."}]," ","Free-plan questions run on free open models. Free model hosts may log prompts, and some may use them to improve their models. On Free, Keplar does not send your saved memory or the text of attached documents to those models, and no model learns new memory from your Free chats. Plus and Pro requests are sent only to endpoints that say they do not train on prompts."]}],["$","li","Your account. Signed in, your chats, study sets, slide decks and (if on) memory are stored in Keplar's database under your account. Signed out, chats stay in your browser only.",{"children":[["$","strong",null,{"children":"Your account."}]," ","Signed in, your chats, study sets, slide decks and (if on) memory are stored in Keplar's database under your account. Signed out, chats stay in your browser only."]}],["$","li","You are in control. You can delete chats, study sets, decks and individual memory items in the app, turn memory off, erase all memory and chat history, delete your whole account from Account, or email us.",{"children":[["$","strong",null,{"children":"You are in control."}]," ","You can delete chats, study sets, decks and individual memory items in the app, turn memory off, erase all memory and chat history, delete your whole account from Account, or email us."]}],["$","li","No ads. Keplar does not sell your personal data and does not show ads. On its public marketing pages (never in the app, your account, checkout or sign-in) Keplar uses the Whop Pixel to measure how its own ads perform (see Cookies and local storage).",{"children":[["$","strong",null,{"children":"No ads."}]," ","Keplar does not sell your personal data and does not show ads. On its public marketing pages (never in the app, your account, checkout or sign-in) Keplar uses the Whop Pixel to measure how its own ads perform (see Cookies and local storage)."]}]]}]]]}]
5:["$","section","data-flow",{"id":"data-flow","className":"Legal-module__2dCIza__section","aria-labelledby":"data-flow-h","data-still":true,"children":[["$","h2",null,{"id":"data-flow-h","className":"Legal-module__2dCIza__h2","children":[["$","span",null,{"className":"Legal-module__2dCIza__num","aria-hidden":"true","children":"02"}],["$","span",null,{"children":"How a request moves through Keplar"}],["$","a",null,{"href":"#data-flow","className":"Legal-module__2dCIza__anchor","aria-label":"Link to How a request moves through Keplar","children":"#"}]]}],[["$","p","0",{"className":"Legal-module__2dCIza__p","children":"Every question follows the same path. Understanding it makes the rest of this policy easier to follow."}],["$","figure","1",{"className":"Legal-module__2dCIza__flow","children":[["$","ol",null,{"className":"Legal-module__2dCIza__flowSteps","children":[["$","li","0",{"className":"Legal-module__2dCIza__flowStep","children":[["$","span",null,{"className":"Legal-module__2dCIza__flowIndex","aria-hidden":"true","children":"01"}],["$","span",null,{"className":"Legal-module__2dCIza__flowNode","aria-hidden":"true","children":["$","span",null,{"className":"Legal-module__2dCIza__flowDot"}]}],["$","span",null,{"className":"Legal-module__2dCIza__flowName","children":"You"}],["$","span",null,{"className":"Legal-module__2dCIza__flowNote","children":"Prompt and files"}]]}],["$","li","1",{"className":"Legal-module__2dCIza__flowStep","children":[["$","span",null,{"className":"Legal-module__2dCIza__flowIndex","aria-hidden":"true","children":"02"}],["$","span",null,{"className":"Legal-module__2dCIza__flowNode","aria-hidden":"true","children":["$","svg",null,{"viewBox":"0 0 398 398","width":14,"height":14,"aria-hidden":true,"focusable":"false","fill":"currentColor","children":[null,["$","rect",null,{"x":0,"y":0,"width":229,"height":229,"rx":70}],["$","path",null,{"d":"M204.95 11.95A7 7 0 0 1 209.9 0L362 0A16 16 0 0 1 378 16L378 168.1A7 7 0 0 1 366.05 173.05Z"}],["$","circle",null,{"cx":281,"cy":281,"r":117}]]}]}],["$","span",null,{"className":"Legal-module__2dCIza__flowName","children":"Keplar"}],["$","span",null,{"className":"Legal-module__2dCIza__flowNote","children":"Classifies, selects models"}]]}],["$","li","2",{"className":"Legal-module__2dCIza__flowStep","data-kind":"providers","children":[["$","span",null,{"className":"Legal-module__2dCIza__flowIndex","aria-hidden":"true","children":"03"}],["$","span",null,{"className":"Legal-module__2dCIza__flowNode","aria-hidden":"true","children":["$","span",null,{"className":"Legal-module__2dCIza__flowLanes","children":[["$","i",null,{}],["$","i",null,{}],["$","i",null,{}]]}]}],["$","span",null,{"className":"Legal-module__2dCIza__flowName","children":"Selected model providers"}],["$","span",null,{"className":"Legal-module__2dCIza__flowNote","children":"Only those chosen for this request"}]]}],["$","li","3",{"className":"Legal-module__2dCIza__flowStep","data-kind":"keplar","children":[["$","span",null,{"className":"Legal-module__2dCIza__flowIndex","aria-hidden":"true","children":"04"}],["$","span",null,{"className":"Legal-module__2dCIza__flowNode","aria-hidden":"true","children":["$","svg",null,{"viewBox":"0 0 398 398","width":14,"height":14,"aria-hidden":true,"focusable":"false","fill":"currentColor","children":[null,["$","rect",null,{"x":0,"y":0,"width":229,"height":229,"rx":70}],["$","path",null,{"d":"M204.95 11.95A7 7 0 0 1 209.9 0L362 0A16 16 0 0 1 378 16L378 168.1A7 7 0 0 1 366.05 173.05Z"}],["$","circle",null,{"cx":281,"cy":281,"r":117}]]}]}],["$","span",null,{"className":"Legal-module__2dCIza__flowName","children":"Keplar-One synthesis"}],["$","span",null,{"className":"Legal-module__2dCIza__flowNote","children":"Compares, weighs the evidence, writes one answer"}]]}],["$","li","4",{"className":"Legal-module__2dCIza__flowStep","children":[["$","span",null,{"className":"Legal-module__2dCIza__flowIndex","aria-hidden":"true","children":"05"}],["$","span",null,{"className":"Legal-module__2dCIza__flowNode","aria-hidden":"true","children":["$","span",null,{"className":"Legal-module__2dCIza__flowDot"}]}],["$","span",null,{"className":"Legal-module__2dCIza__flowName","children":"You"}],["$","span",null,{"className":"Legal-module__2dCIza__flowNote","children":"One answer, with its consensus"}]]}]]}],["$","figcaption",null,{"className":"Legal-module__2dCIza__flowCaption","children":"How a request moves: from you, through Keplar and the model providers it selects, back to you as one answer."}]]}],"$L2d","$L2e"]]}]
6:["$","section","information-you-provide",{"id":"information-you-provide","className":"Legal-module__2dCIza__section","aria-labelledby":"information-you-provide-h","data-still":true,"children":[["$","h2",null,{"id":"information-you-provide-h","className":"Legal-module__2dCIza__h2","children":[["$","span",null,{"className":"Legal-module__2dCIza__num","aria-hidden":"true","children":"03"}],["$","span",null,{"children":"Information you provide"}],["$","a",null,{"href":"#information-you-provide","className":"Legal-module__2dCIza__anchor","aria-label":"Link to Information you provide","children":"#"}]]}],[["$","p","0",{"className":"Legal-module__2dCIza__p","children":"This is information you choose to give Keplar directly."}],["$","ul","1",{"className":"Legal-module__2dCIza__list","children":[["$","li","Account details",{"children":"Account details"}],["$","li","Prompts and conversations",{"children":"Prompts and conversations"}],["$","li","Files, images and video you attach",{"children":"Files, images and video you attach"}],["$","li","Study guides and slide material you upload",{"children":"Study guides and slide material you upload"}],["$","li","Memory notes",{"children":"Memory notes"}],["$","li","Payment details, when you subscribe",{"children":"Payment details, when you subscribe"}],["$","li","Messages you send us, including inquiries and support emails",{"children":"Messages you send us, including inquiries and support emails"}]]}]]]}]
7:["$","section","account-information",{"id":"account-information","className":"Legal-module__2dCIza__section","aria-labelledby":"account-information-h","data-still":true,"children":[["$","h2",null,{"id":"account-information-h","className":"Legal-module__2dCIza__h2","children":[["$","span",null,{"className":"Legal-module__2dCIza__num","aria-hidden":"true","children":"04"}],["$","span",null,{"children":"Account information"}],["$","a",null,{"href":"#account-information","className":"Legal-module__2dCIza__anchor","aria-label":"Link to Account information","children":"#"}]]}],[["$","p","0",{"className":"Legal-module__2dCIza__p","children":"To create and run your account, Keplar needs your email address and, if you sign in with Google or Microsoft, the name and verified email they share with us. You can also sign in with a one-time link sent to your email, so no password is stored. We use your email to identify your account, send sign-in links and billing messages, and reply to you."}],["$","p","1",{"className":"Legal-module__2dCIza__p","children":"Sign-in emails are sent through Resend. Sign-in with Google or Microsoft is handled by that company under its own privacy policy; Keplar receives only the profile details you approve."}]]]}]
8:["$","section","prompts-and-conversations",{"id":"prompts-and-conversations","className":"Legal-module__2dCIza__section","aria-labelledby":"prompts-and-conversations-h","data-still":true,"children":[["$","h2",null,{"id":"prompts-and-conversations-h","className":"Legal-module__2dCIza__h2","children":[["$","span",null,{"className":"Legal-module__2dCIza__num","aria-hidden":"true","children":"05"}],["$","span",null,{"children":"Prompts and conversations"}],["$","a",null,{"href":"#prompts-and-conversations","className":"Legal-module__2dCIza__anchor","aria-label":"Link to Prompts and conversations","children":"#"}]]}],[["$","p","0",{"className":"Legal-module__2dCIza__p","children":"When you are signed in, your prompts, Keplar's answers and the details shown with them (consensus, models consulted, sources, disagreements) are saved to your account in Keplar's database so you can reopen, rename and delete your chats on any device. Images and video you attach are used for that request only and are not saved with the chat."}],["$","p","1",{"className":"Legal-module__2dCIza__p","children":"When you are signed out, chats are kept only in your browser's local storage on that device. Clearing your browser data removes them."}],["$","p","2",{"className":"Legal-module__2dCIza__p","children":"Don't include information in a prompt that you aren't comfortable sharing with the model providers selected to answer it."}]]]}]
9:["$","section","memory",{"id":"memory","className":"Legal-module__2dCIza__section","aria-labelledby":"memory-h","data-still":true,"children":[["$","h2",null,{"id":"memory-h","className":"Legal-module__2dCIza__h2","children":[["$","span",null,{"className":"Legal-module__2dCIza__num","aria-hidden":"true","children":"06"}],["$","span",null,{"children":"Saved chats and memory"}],["$","a",null,{"href":"#memory","className":"Legal-module__2dCIza__anchor","aria-label":"Link to Saved chats and memory","children":"#"}]]}],[["$","p","0",{"className":"Legal-module__2dCIza__p","children":"Memory is on by default for signed-in accounts and you can turn it off at any time in Account or by saying \"turn memory off\" in a chat. It is not available when you are signed out."}],["$","p","1",{"className":"Legal-module__2dCIza__p","children":"When it is on, after an answer a free model reads your own message and may save short, durable facts about you, such as your name, goals, preferences or ongoing projects. It skips small talk and messages that look like pasted documents, it never reads files you upload, it does not use your credits, and it will not save instructions, links or sensitive items such as passwords or card numbers. Because the free models that do this may be hosted by companies that log prompts, your message is shared with such a host when extraction runs."}],["$","p","2",{"className":"Legal-module__2dCIza__p","children":"With memory on, a free model also writes a one or two sentence summary of each chat you have while signed in, and Keplar keeps the last few question and answer pairs of that chat in a short digest so it can answer \"what did we talk about last time?\" and find relevant earlier chats. For a message with an attached file or image only your question is kept, never the answer. New chats start with your saved notes and short summaries of your last few chats, and later questions may include a few relevant passages from earlier chats. Summaries are deleted with the chat, and erased with your memory. On the Free plan no model reads your chats for this: summaries stay extractive and the only notes are the ones you add yourself."}],["$","p","3",{"className":"Legal-module__2dCIza__p","children":"Within a chat, the recent messages of that conversation (older ones shortened) are always sent along with your question so follow-ups work, signed in or not."}],["$","p","4",{"className":"Legal-module__2dCIza__p","children":"Saved items that are relevant to a later question are sent along with it to the models answering, so they are covered by the same provider handling as the rest of your prompt. Nothing is sent when memory is off or after you delete it. The Free plan is the exception: because Free model hosts may log prompts and use them to improve their models, your saved items, summaries and snippets of past chats are not sent in Free requests at all."}],["$","p","5",{"className":"Legal-module__2dCIza__p","children":"You can see every item in Account, add your own, delete any one, or erase all memory, optionally together with your saved chat history. You can also say \"forget that\", \"erase my memory\" or \"remember that...\" in a chat. Deleting removes the data from Keplar's database. Keplar does not train models on your memory or chats."}]]]}]
a:["$","section","files",{"id":"files","className":"Legal-module__2dCIza__section","aria-labelledby":"files-h","data-still":true,"children":[["$","h2",null,{"id":"files-h","className":"Legal-module__2dCIza__h2","children":[["$","span",null,{"className":"Legal-module__2dCIza__num","aria-hidden":"true","children":"07"}],["$","span",null,{"children":"Files, study guides and slide decks"}],["$","a",null,{"href":"#files","className":"Legal-module__2dCIza__anchor","aria-label":"Link to Files, study guides and slide decks","children":"#"}]]}],[["$","p","0",{"className":"Legal-module__2dCIza__p","children":"When you attach a file to a question, Keplar reads its contents to answer you and may send relevant parts to the selected model providers."}],["$","p","1",{"className":"Legal-module__2dCIza__p","children":"Study mode reads the text of a PDF, text file or pasted notes and sends parts of it to the model that builds your outline, flashcards, quizzes and answers. The extracted text, the study set Keplar builds, and your progress are stored in your account so you can keep studying, until you delete the set. Deleting it removes the text and your progress. The original file itself is not kept. Scanned PDFs are not read."}],["$","p","2",{"className":"Legal-module__2dCIza__p","children":"The slideshow creator (Plus and Pro) sends your topic, outline and any source text to the model that writes the deck. The finished deck is stored in your account until you delete it. The source file is not kept."}],["$","p","3",{"className":"Legal-module__2dCIza__p","children":"Text inside a document is treated as material to read, never as instructions to Keplar."}]]]}]
b:["$","section","voice",{"id":"voice","className":"Legal-module__2dCIza__section","aria-labelledby":"voice-h","data-still":true,"children":[["$","h2",null,{"id":"voice-h","className":"Legal-module__2dCIza__h2","children":[["$","span",null,{"className":"Legal-module__2dCIza__num","aria-hidden":"true","children":"08"}],["$","span",null,{"children":"Voice dictation and voice mode (beta)"}],["$","a",null,{"href":"#voice","className":"Legal-module__2dCIza__anchor","aria-label":"Link to Voice dictation and voice mode (beta)","children":"#"}]]}],[["$","p","0",{"className":"Legal-module__2dCIza__p","children":"The microphone button in the Ask box uses your browser's built-in speech recognition (Web Speech API), only when you click it, and only in browsers that provide it. Your browser asks for microphone permission at that moment. In Chrome, Edge and Safari the browser itself may send your voice to its vendor's speech service to turn it into text; that is governed by your browser vendor's policy, not Keplar's. Keplar never receives, records or stores audio. It receives only the text that appears in the message box, which you can edit before sending, and which is then handled like any other prompt. In browsers without this feature (for example Firefox) the button is not shown."}],["$","p","1",{"className":"Legal-module__2dCIza__p","children":"Voice mode (beta) adds a Talk button and a Listen button on answers. Talk uses the same browser speech recognition: hold the button to speak and release to send, or tap once to keep listening and tap again to send. The text it produces is sent as your question like any typed question. Listen reads an answer aloud with your browser's own text-to-speech voices (speechSynthesis); the answer text is already on your screen and Keplar sends it to no speech service. Some browsers use on-device voices and some use online voices run by the browser vendor, under the vendor's policy. Keplar never receives, records or stores audio, and keeps no voice recordings or voiceprints. Your browser asks for microphone permission when you first press Talk, and you can withdraw it in your browser's site settings at any time. If your browser has no speech recognition (for example Firefox), Talk explains that and you can keep typing; if it has no read-aloud voices, the Listen button is not shown."}]]]}]
c:["$","section","optional-learning",{"id":"optional-learning","className":"Legal-module__2dCIza__section","aria-labelledby":"optional-learning-h","data-still":true,"children":[["$","h2",null,{"id":"optional-learning-h","className":"Legal-module__2dCIza__h2","children":[["$","span",null,{"className":"Legal-module__2dCIza__num","aria-hidden":"true","children":"09"}],["$","span",null,{"children":"Optional: Help improve Keplar and common questions"}],["$","a",null,{"href":"#optional-learning","className":"Legal-module__2dCIza__anchor","aria-label":"Link to Optional: Help improve Keplar and common questions","children":"#"}]]}],[["$","p","0",{"className":"Legal-module__2dCIza__p","children":"Keplar learns at the system level, not by retraining models. After each answer it records content-free results, such as the type of question, which models answered, whether they agreed, speed, credits used and whether you rated, copied or regenerated the answer. These records contain no question text and are deleted after 45 days."}],["$","p","1",{"className":"Legal-module__2dCIza__p","children":"Two settings are off by default and only apply when you are signed in and turn them on:"}],["$","ul","2",{"className":"Legal-module__2dCIza__list","children":[["$","li","Help improve Keplar. If you turn it on, a question that failed (no model answered, a thumbs-down, an ask-again or a correction) is kept as a shortened, cleaned copy in your own account, with emails, links, long numbers and key-like text removed. Copies that look sensitive are dropped. They are used to check Keplar's routing before changes go live, and Keplar's administrators can see them without your account details. They appear in your data export and can be deleted in Settings; turning the setting off, or deleting your account, deletes them. No AI model is trained on them.",{"children":[["$","strong",null,{"children":"Help improve Keplar."}]," ","If you turn it on, a question that failed (no model answered, a thumbs-down, an ask-again or a correction) is kept as a shortened, cleaned copy in your own account, with emails, links, long numbers and key-like text removed. Copies that look sensitive are dropped. They are used to check Keplar's routing before changes go live, and Keplar's administrators can see them without your account details. They appear in your data export and can be deleted in Settings; turning the setting off, or deleting your account, deletes them. No AI model is trained on them."]}],["$","li","Count my questions. If you turn it on, general questions you ask may be counted toward a public \"most frequently asked\" list. A question is stored only as a keyed hash until at least five different people have asked the same thing, and only then is its text shown, with a count and nothing about who asked. Questions with personal details, links or numbers are never counted. Turning the setting off removes you from the counts.",{"children":[["$","strong",null,{"children":"Count my questions."}]," ","If you turn it on, general questions you ask may be counted toward a public \"most frequently asked\" list. A question is stored only as a keyed hash until at least five different people have asked the same thing, and only then is its text shown, with a count and nothing about who asked. Questions with personal details, links or numbers are never counted. Turning the setting off removes you from the counts."]}]]}]]]}]
2f:T47f,Templates (beta). A site becomes a public template only if your email is verified and you press Share as template and tick the box that says it will be public and copyable. Keplar then stores a separate snapshot of the pages, text, layout and styles of your latest version, shows it at an address on keplar.one/templates that search engines may index, and shows the title, description and category you wrote, plus a name only if you type one. It never includes form messages, contacts, bookings, orders, members, analytics, chat history, uploaded photos or contact links, and Keplar refuses to share a site where it detects an email address, phone number, card number or key, or a members-only page. When someone presses Remix, a copy of the snapshot is made in their workspace; it is theirs and is not linked to yours, and we count remixes on the template. You can withdraw a template at any time, and deleting the site or your account removes the snapshot; copies other people already made, and cached copies at search engines, are not recalled. Reports of a template are stored for the Keplar team to review by hand, and Keplar can hide a template.d:["$","section","creation-media",{"id":"creation-media","className":"Legal-module__2dCIza__section","aria-labelledby":"creation-media-h","data-still":true,"children":[["$","h2",null,{"id":"creation-media-h","className":"Legal-module__2dCIza__h2","children":[["$","span",null,{"className":"Legal-module__2dCIza__num","aria-hidden":"true","children":"10"}],["$","span",null,{"children":"Images, video and creation tools"}],["$","a",null,{"href":"#creation-media","className":"Legal-module__2dCIza__anchor","aria-label":"Link to Images, video and creation tools","children":"#"}]]}],[["$","p","0",{"className":"Legal-module__2dCIza__p","children":"When you ask Keplar to create an image or video, your prompt and any reference images or video you add are sent to the generation provider for that request, currently Higgsfield. Keplar then saves a copy of the result in your account, and you can delete it there. The provider may keep its own copy of a finished output for at least 7 days, and handles it under its own terms. Prompts and results are also checked by automated safety filters, which can include a moderation service from OpenAI."}],["$","p","1",{"className":"Legal-module__2dCIza__p","children":"Sites, apps and code you build are stored in your account until you delete them. If you publish a site, what you publish is public."}],["$","p","2",{"className":"Legal-module__2dCIza__p","children":"$2f"}]]]}]
e:["$","section","feedback-and-sharing",{"id":"feedback-and-sharing","className":"Legal-module__2dCIza__section","aria-labelledby":"feedback-and-sharing-h","data-still":true,"children":[["$","h2",null,{"id":"feedback-and-sharing-h","className":"Legal-module__2dCIza__h2","children":[["$","span",null,{"className":"Legal-module__2dCIza__num","aria-hidden":"true","children":"11"}],["$","span",null,{"children":"Feedback and shared answer links"}],["$","a",null,{"href":"#feedback-and-sharing","className":"Legal-module__2dCIza__anchor","aria-label":"Link to Feedback and shared answer links","children":"#"}]]}],[["$","p","0",{"className":"Legal-module__2dCIza__p","children":"If you send feedback through Keplar, we store your message, the page or campaign it came from and your plan. We store your email address only if you tick the box that lets us contact you. A copy of each message is also emailed to the Keplar team at team@keplar.one (through our email provider, Resend). Feedback you send while signed in is part of your account data and is deleted with your account; the copy in the teamâ€™s inbox is deleted when you ask us to at team@keplar.one."}],["$","p","1",{"className":"Legal-module__2dCIza__p","children":"A shared answer link is created only when you press Create link. It shows one answer, how many models agreed and which were consulted, and your question only if you leave it ticked. It never includes your name, email, history or memory. You can revoke it at any time, it expires after 90 days, search engines are told not to index it, and viewing it only adds to a counter, with no IP address or browser details stored."}],["$","p","2",{"className":"Legal-module__2dCIza__p","children":"Separately, if your email is verified you can choose Make public on a link you created. That is a second, explicit choice. It publishes your question and the answer at an address on keplar.one/answers that search engines may index, and lists it there. It never includes your name, email, history or memory, and Keplar refuses to publish a page where it detects an email address, phone number, card number or key. Anyone can copy a public page, and search engines may keep a cached copy for a while after you turn it off. Making it private, revoking the link, or deleting your account removes the page from keplar.one at once. Keplar can take down a public page that is reported or breaks the Terms."}]]]}]
f:["$","section","usage-information",{"id":"usage-information","className":"Legal-module__2dCIza__section","aria-labelledby":"usage-information-h","data-still":true,"children":[["$","h2",null,{"id":"usage-information-h","className":"Legal-module__2dCIza__h2","children":[["$","span",null,{"className":"Legal-module__2dCIza__num","aria-hidden":"true","children":"12"}],["$","span",null,{"children":"Usage information"}],["$","a",null,{"href":"#usage-information","className":"Legal-module__2dCIza__anchor","aria-label":"Link to Usage information","children":"#"}]]}],[["$","p","0",{"className":"Legal-module__2dCIza__p","children":"Keplar records how much of your plan you use so it can enforce limits and show your meter: the type of action, the number of credits, the cost and the time. It also keeps short-lived counters for rate limiting and abuse prevention, and error logs on our hosting provider."}]]]}]
10:["$","section","device-information",{"id":"device-information","className":"Legal-module__2dCIza__section","aria-labelledby":"device-information-h","data-still":true,"children":[["$","h2",null,{"id":"device-information-h","className":"Legal-module__2dCIza__h2","children":[["$","span",null,{"className":"Legal-module__2dCIza__num","aria-hidden":"true","children":"13"}],["$","span",null,{"children":"Device and connection information"}],["$","a",null,{"href":"#device-information","className":"Legal-module__2dCIza__anchor","aria-label":"Link to Device and connection information","children":"#"}]]}],[["$","p","0",{"className":"Legal-module__2dCIza__p","children":"Like any website, our servers and hosting provider receive your IP address, browser type and the pages you request. We use this to deliver the site, apply rate limits (including per-IP limits for signed-out Free use) and protect against abuse."}]]]}]
11:["$","section","cookies",{"id":"cookies","className":"Legal-module__2dCIza__section","aria-labelledby":"cookies-h","data-still":true,"children":[["$","h2",null,{"id":"cookies-h","className":"Legal-module__2dCIza__h2","children":[["$","span",null,{"className":"Legal-module__2dCIza__num","aria-hidden":"true","children":"14"}],["$","span",null,{"children":"Cookies and local storage"}],["$","a",null,{"href":"#cookies","className":"Legal-module__2dCIza__anchor","aria-label":"Link to Cookies and local storage","children":"#"}]]}],[["$","p","0",{"className":"Legal-module__2dCIza__p","children":"Essential cookies and storage are always on, because Keplar cannot work or stay secure without them. The only optional category is analytics, and it stays off until you allow it (the Whop Pixel for ad measurement, described after the list, is separate and is not part of that choice):"}],["$","ul","1",{"className":"Legal-module__2dCIza__list","children":[["$","li","Sign-in session. A secure, signed cookie that keeps you signed in.",{"children":[["$","strong",null,{"children":"Sign-in session."}]," ","A secure, signed cookie that keeps you signed in."]}],["$","li","Plan. A signed, HttpOnly cookie that records your paid plan and billing period after a verified payment.",{"children":[["$","strong",null,{"children":"Plan."}]," ","A signed, HttpOnly cookie that records your paid plan and billing period after a verified payment."]}],["$","li","Free usage count. A signed, HttpOnly cookie that counts a signed-out or Free browser's questions for the day.",{"children":[["$","strong",null,{"children":"Free usage count."}]," ","A signed, HttpOnly cookie that counts a signed-out or Free browser's questions for the day."]}],["$","li","Theme. Your light, dark or system choice, in a cookie and local storage.",{"children":[["$","strong",null,{"children":"Theme."}]," ","Your light, dark or system choice, in a cookie and local storage."]}],["$","li","Invite link (only if you open one). kp_ref (HttpOnly, 30 days) holds the invite code until your new account claims it, kp_ref_p is a flag saying an invite is waiting, and kp_dev (HttpOnly, 12 months) is a random browser id used only to stop one browser claiming many referral rewards. See the Referral Terms.",{"children":[["$","strong",null,{"children":"Invite link (only if you open one)."}]," ","kp_ref (HttpOnly, 30 days) holds the invite code until your new account claims it, kp_ref_p is a flag saying an invite is waiting, and kp_dev (HttpOnly, 12 months) is a random browser id used only to stop one browser claiming many referral rewards. See the Referral Terms."]}],["$","li","Your cookie choice. A first-party cookie (keplar_consent, 12 months) and a copy in local storage recording what you allowed, the date, and the version of the categories. You are asked again after 12 months or if the categories change.",{"children":[["$","strong",null,{"children":"Your cookie choice."}]," ","A first-party cookie (keplar_consent, 12 months) and a copy in local storage recording what you allowed, the date, and the version of the categories. You are asked again after 12 months or if the categories change."]}],["$","li","Campaign tags. If you arrive from a link with utm_ tags, Keplar keeps them in this tab's session storage (cleared when you close the tab) so it can tell which campaign led to a sign-up.",{"children":[["$","strong",null,{"children":"Campaign tags."}]," ","If you arrive from a link with utm_ tags, Keplar keeps them in this tab's session storage (cleared when you close the tab) so it can tell which campaign led to a sign-up."]}],["$","li","App data in your browser. Your chats while signed out, your settings, your \"what will you use Keplar for\" choice and upgrade-note dismissals, in local storage on your device.",{"children":"$L30"}]]}],"$L31","$L32","$L33","$L34","$L35","$L36"]]}]
12:["$","section","payment-information",{"id":"payment-information","className":"Legal-module__2dCIza__section","aria-labelledby":"payment-information-h","data-still":true,"children":[["$","h2",null,{"id":"payment-information-h","className":"Legal-module__2dCIza__h2","children":[["$","span",null,{"className":"Legal-module__2dCIza__num","aria-hidden":"true","children":"15"}],["$","span",null,{"children":"Payment information"}],["$","a",null,{"href":"#payment-information","className":"Legal-module__2dCIza__anchor","aria-label":"Link to Payment information","children":"#"}]]}],[["$","p","0",{"className":"Legal-module__2dCIza__p","children":"Subscriptions are processed by Whop, which handles your card details and shows you the checkout page. Keplar never sees your full card number. We receive and store the billing details we need to run your plan: your plan, its status, the billing period, whether it renews or cancels, and a link to manage your subscription."}],["$","p","1",{"className":"Legal-module__2dCIza__p","children":"If you use Keplar Business commerce tools, payments from your own customers are processed by Stripe under your connected Stripe account."}]]]}]
13:["$","section","how-we-use-information",{"id":"how-we-use-information","className":"Legal-module__2dCIza__section","aria-labelledby":"how-we-use-information-h","data-still":true,"children":[["$","h2",null,{"id":"how-we-use-information-h","className":"Legal-module__2dCIza__h2","children":[["$","span",null,{"className":"Legal-module__2dCIza__num","aria-hidden":"true","children":"16"}],["$","span",null,{"children":"How Keplar uses information"}],["$","a",null,{"href":"#how-we-use-information","className":"Legal-module__2dCIza__anchor","aria-label":"Link to How Keplar uses information","children":"#"}]]}],[["$","ul","0",{"className":"Legal-module__2dCIza__list","children":[["$","li","To answer your requests, including routing them to model providers and synthesizing the result.",{"children":"To answer your requests, including routing them to model providers and synthesizing the result."}],["$","li","To run your account, save your chats, study sets and decks, measure Keplar Usage and process payments.",{"children":"To run your account, save your chats, study sets and decks, measure Keplar Usage and process payments."}],["$","li","To keep Keplar secure, prevent abuse and enforce our Terms.",{"children":"To keep Keplar secure, prevent abuse and enforce our Terms."}],["$","li","To support you when you contact us.",{"children":"To support you when you contact us."}],["$","li","To fix problems and understand overall usage, using the counters and logs described above.",{"children":"To fix problems and understand overall usage, using the counters and logs described above."}],["$","li","To meet legal obligations.",{"children":"To meet legal obligations."}]]}],["$","p","1",{"className":"Legal-module__2dCIza__p","children":"Keplar does not use your prompts, files, memory or chats to train AI models, and does not sell your personal data."}]]]}]
14:["$","section","model-providers",{"id":"model-providers","className":"Legal-module__2dCIza__section","aria-labelledby":"model-providers-h","data-still":true,"children":[["$","h2",null,{"id":"model-providers-h","className":"Legal-module__2dCIza__h2","children":[["$","span",null,{"className":"Legal-module__2dCIza__num","aria-hidden":"true","children":"17"}],["$","span",null,{"children":"AI model providers"}],["$","a",null,{"href":"#model-providers","className":"Legal-module__2dCIza__anchor","aria-label":"Link to AI model providers","children":"#"}]]}],[["$","p","0",{"className":"Legal-module__2dCIza__p","children":"Keplar is an intelligence layer above AI models from several providers. For each request, Keplar-One selects the models it needs based on the task, quality, reliability, speed and cost. Requests reach models through OpenRouter, and directly through OpenAI and NVIDIA for some models. The Models consulted section of every answer shows which models were used, and that set changes as models are added or retired. Images and video are generated by Higgsfield, as described under Images, video and creation tools."}],["$","ul","1",{"className":"Legal-module__2dCIza__list","children":[["$","li","Free plan. Free requests use free open models served by hosts on OpenRouter. These hosts may log prompts and may use them to improve their models. Do not put sensitive information in a Free question. Keplar never sends saved memory or the text of attached documents to these hosts (a Free question with an attached document is refused with an explanation); images and video you attach to a Free question are sent, because the question needs them.",{"children":[["$","strong",null,{"children":"Free plan."}]," ","Free requests use free open models served by hosts on OpenRouter. These hosts may log prompts and may use them to improve their models. Do not put sensitive information in a Free question. Keplar never sends saved memory or the text of attached documents to these hosts (a Free question with an attached document is refused with an explanation); images and video you attach to a Free question are sent, because the question needs them."]}],["$","li","Plus and Pro. Requests sent through OpenRouter are restricted to endpoints that state they do not collect or train on prompts, and models are not routed to the first-party DeepSeek API. Requests sent directly to OpenAI or NVIDIA are handled under their API terms. Providers may still keep requests for a limited time, for example to detect abuse.",{"children":[["$","strong",null,{"children":"Plus and Pro."}]," ","Requests sent through OpenRouter are restricted to endpoints that state they do not collect or train on prompts, and models are not routed to the first-party DeepSeek API. Requests sent directly to OpenAI or NVIDIA are handled under their API terms. Providers may still keep requests for a limited time, for example to detect abuse."]}]]}],["$","p","2",{"className":"Legal-module__2dCIza__p","children":"Each provider handles data under its own terms and privacy policy, which we don't control. Data a provider keeps under those terms may persist after you delete it from Keplar."}]]]}]
15:["$","section","infrastructure-providers",{"id":"infrastructure-providers","className":"Legal-module__2dCIza__section","aria-labelledby":"infrastructure-providers-h","data-still":true,"children":[["$","h2",null,{"id":"infrastructure-providers-h","className":"Legal-module__2dCIza__h2","children":[["$","span",null,{"className":"Legal-module__2dCIza__num","aria-hidden":"true","children":"18"}],["$","span",null,{"children":"Infrastructure and service providers"}],["$","a",null,{"href":"#infrastructure-providers","className":"Legal-module__2dCIza__anchor","aria-label":"Link to Infrastructure and service providers","children":"#"}]]}],[["$","p","0",{"className":"Legal-module__2dCIza__p","children":"Keplar relies on other companies to run the service. They process data on Keplar's behalf only to provide their service:"}],["$","ul","1",{"className":"Legal-module__2dCIza__list","children":[["$","li","Vercel. Hosts the website and application, and provides Vercel Web Analytics and Speed Insights on the public marketing pages (see Cookies and local storage).",{"children":[["$","strong",null,{"children":"Vercel."}]," ","Hosts the website and application, and provides Vercel Web Analytics and Speed Insights on the public marketing pages (see Cookies and local storage)."]}],["$","li","Neon. Hosts the Postgres database that stores accounts, chats, study sets, decks, memory and usage records.",{"children":[["$","strong",null,{"children":"Neon."}]," ","Hosts the Postgres database that stores accounts, chats, study sets, decks, memory and usage records."]}],["$","li","Resend. Sends sign-in and account emails.",{"children":"Resend. Sends sign-in and account emails."}],["$","li","Whop. Processes subscription payments, and provides the Whop Pixel used to measure Keplar's ads on the public marketing pages (see Cookies and local storage).",{"children":[["$","strong",null,{"children":"Whop."}]," ","Processes subscription payments, and provides the Whop Pixel used to measure Keplar's ads on the public marketing pages (see Cookies and local storage)."]}],["$","li","Google and Microsoft. Provide optional sign-in with your Google or Microsoft account.",{"children":[["$","strong",null,{"children":"Google and Microsoft."}]," ","Provide optional sign-in with your Google or Microsoft account."]}],["$","li","OpenRouter, OpenAI and NVIDIA. Provide AI models, as described above. OpenAI also provides content moderation for the creation tools.",{"children":[["$","strong",null,{"children":"OpenRouter, OpenAI and NVIDIA."}]," ","Provide AI models, as described above. OpenAI also provides content moderation for the creation tools."]}],["$","li","Higgsfield. Generates images and video from your prompt and reference files.",{"children":[["$","strong",null,{"children":"Higgsfield."}]," ","Generates images and video from your prompt and reference files."]}],["$","li","Upstash. Stores short-lived rate-limit counters, keyed by hashes rather than names or emails, when it is configured.",{"children":[["$","strong",null,{"children":"Upstash."}]," ","Stores short-lived rate-limit counters, keyed by hashes rather than names or emails, when it is configured."]}],["$","li","Stripe. Used only for Keplar Business sellers: payments from your own customers go through your connected Stripe account. Stripe is not used to bill Keplar plans.",{"children":[["$","strong",null,{"children":"Stripe."}]," ","Used only for Keplar Business sellers: payments from your own customers go through your connected Stripe account. Stripe is not used to bill Keplar plans."]}]]}],["$","p","2",{"className":"Legal-module__2dCIza__p","children":"We do not sell this data and give these companies only what they need to do their job. If we add or replace a provider that handles your personal data, we will update this list and the date at the top."}]]]}]
16:["$","section","sharing",{"id":"sharing","className":"Legal-module__2dCIza__section","aria-labelledby":"sharing-h","data-still":true,"children":[["$","h2",null,{"id":"sharing-h","className":"Legal-module__2dCIza__h2","children":[["$","span",null,{"className":"Legal-module__2dCIza__num","aria-hidden":"true","children":"19"}],["$","span",null,{"children":"When else information is shared"}],["$","a",null,{"href":"#sharing","className":"Legal-module__2dCIza__anchor","aria-label":"Link to When else information is shared","children":"#"}]]}],[["$","ul","0",{"className":"Legal-module__2dCIza__list","children":[["$","li","With your organization, if you use a Keplar Business account under its agreement.",{"children":"With your organization, if you use a Keplar Business account under its agreement."}],["$","li","When you ask us to, for example by publishing a site you built with Keplar.",{"children":"When you ask us to, for example by publishing a site you built with Keplar."}],["$","li","To comply with law or protect people's safety and Keplar's rights.",{"children":"To comply with law or protect people's safety and Keplar's rights."}],["$","li","As part of a merger, acquisition or sale of assets, subject to this policy.",{"children":"As part of a merger, acquisition or sale of assets, subject to this policy."}]]}]]]}]
17:["$","section","retention",{"id":"retention","className":"Legal-module__2dCIza__section","aria-labelledby":"retention-h","data-still":true,"children":[["$","h2",null,{"id":"retention-h","className":"Legal-module__2dCIza__h2","children":[["$","span",null,{"className":"Legal-module__2dCIza__num","aria-hidden":"true","children":"20"}],["$","span",null,{"children":"How long data is kept"}],["$","a",null,{"href":"#retention","className":"Legal-module__2dCIza__anchor","aria-label":"Link to How long data is kept","children":"#"}]]}],[["$","ul","0",{"className":"Legal-module__2dCIza__list","children":[["$","li","Chats, study sets, decks and memory. Kept in your account until you delete them. Deleting in the app, or using the erase options, removes them from the database.",{"children":[["$","strong",null,{"children":"Chats, study sets, decks and memory."}]," ","Kept in your account until you delete them. Deleting in the app, or using the erase options, removes them from the database."]}],["$","li","Signed-out chats. Only in your browser, until you clear it.",{"children":"Signed-out chats. Only in your browser, until you clear it."}],["$","li","Account and billing records. Kept while your account exists and as long as needed to meet legal and accounting duties.",{"children":[["$","strong",null,{"children":"Account and billing records."}]," ","Kept while your account exists and as long as needed to meet legal and accounting duties."]}],["$","li","Usage records and logs. Kept as long as needed to run limits, billing and security. Rate-limit counts expire after 60 days.",{"children":[["$","strong",null,{"children":"Usage records and logs."}]," ","Kept as long as needed to run limits, billing and security. Rate-limit counts expire after 60 days."]}],["$","li","Who is on the site now. A code and a last-seen time, gone about 40 seconds after your last signal (or when you leave) and cleared within minutes. No IP address, page or account.",{"children":[["$","strong",null,{"children":"Who is on the site now."}]," ","A code and a last-seen time, gone about 40 seconds after your last signal (or when you leave) and cleared within minutes. No IP address, page or account."]}],["$","li","Visit counts. Anonymous daily codes are kept 35 days, then only daily totals remain. They hold no IP address, no account and no question text.",{"children":[["$","strong",null,{"children":"Visit counts."}]," ","Anonymous daily codes are kept 35 days, then only daily totals remain. They hold no IP address, no account and no question text."]}],["$","li","Product and funnel events. If you allowed analytics, deleted after 180 days. They hold no account details and no question text.",{"children":[["$","strong",null,{"children":"Product and funnel events."}]," ","If you allowed analytics, deleted after 180 days. They hold no account details and no question text."]}],["$","li","Learning records. Content-free routing results are deleted after 45 days. Failed-question copies exist only if you turned on Help improve Keplar, and are kept until you delete them, turn it off or delete your account.",{"children":[["$","strong",null,{"children":"Learning records."}]," ","Content-free routing results are deleted after 45 days. Failed-question copies exist only if you turned on Help improve Keplar, and are kept until you delete them, turn it off or delete your account."]}],["$","li","Shared answer links. Expire after 90 days, or sooner if you revoke them. Public answer pages stay up until you make them private, revoke the link or delete your account.",{"children":[["$","strong",null,{"children":"Shared answer links."}]," ","Expire after 90 days, or sooner if you revoke them. Public answer pages stay up until you make them private, revoke the link or delete your account."]}],"$L37","$L38","$L39"]}],"$L3a"]]}]
18:["$","section","security",{"id":"security","className":"Legal-module__2dCIza__section","aria-labelledby":"security-h","data-still":true,"children":[["$","h2",null,{"id":"security-h","className":"Legal-module__2dCIza__h2","children":[["$","span",null,{"className":"Legal-module__2dCIza__num","aria-hidden":"true","children":"21"}],["$","span",null,{"children":"Security"}],["$","a",null,{"href":"#security","className":"Legal-module__2dCIza__anchor","aria-label":"Link to Security","children":"#"}]]}],[["$","p","0",{"className":"Legal-module__2dCIza__p","children":"Traffic to Keplar is encrypted in transit with HTTPS. Sessions and plan cookies are signed, and the application keeps each account's data separate so that one account cannot read another's chats, study sets, decks or memory. Payment card details never touch Keplar's servers."}],["$","p","1",{"className":"Legal-module__2dCIza__p","children":"No system is perfectly secure. Keplar does not currently hold a security certification or audit, and we'll tell you if a breach affects your data as the law requires. To report a security issue, email the address below."}]]]}]
19:["$","section","business-data",{"id":"business-data","className":"Legal-module__2dCIza__section","aria-labelledby":"business-data-h","data-still":true,"children":[["$","h2",null,{"id":"business-data-h","className":"Legal-module__2dCIza__h2","children":[["$","span",null,{"className":"Legal-module__2dCIza__num","aria-hidden":"true","children":"22"}],["$","span",null,{"children":"Keplar Business and agents"}],["$","a",null,{"href":"#business-data","className":"Legal-module__2dCIza__anchor","aria-label":"Link to Keplar Business and agents","children":"#"}]]}],[["$","p","0",{"className":"Legal-module__2dCIza__p","children":"When your organization uses Keplar Business, its agreement with Keplar governs the content its users submit, and its administrators may be able to access and manage that content."}],["$","p","1",{"className":"Legal-module__2dCIza__p","children":"Agents can keep working after you close the tab. To do that safely, Keplar records what each agent does: the tools it used, the actions it took, approvals requested and granted, and spend against its cap. This record is the audit log you see in the product."}]]]}]
3b:T436,Team workspaces (beta, Business plan). A team is a separate workspace that its members share. Projects, chats and sites created while working in the team belong to the team, not to the person who made them, and every member can see what their role allows. Your personal chats, memory, files and other sites are never shared with a team. The team keeps its member list with their email addresses, the roles, pending invites, and an audit log of who changed membership, roles and exports (the newest 500 entries, visible to admins and the owner). An invite is a draft until the owner or an admin presses Send: the email goes through our email provider only then, or the person copies a one-time link themselves. Invite links are stored only as a hash, expire after 7 days, and work once, for that email address only. When a member is removed, or leaves, their access stops on the very next request. Deleting a team deletes its shared projects, chats and sites; deleting your account removes you from every team you joined. The team owner can download an export of the team's data.3c:T48f,Browser extension (Keplar One). The extension reads the selected text, the text of the page you are on, or the area you drag with Search with Keplar One, only when you press a button or choose a context-menu item, and only on that browser tab, never the rest of your screen. Text is sent to Keplar only when you press Ask, using your API key. Search with Keplar One asks you once before its first search: after you agree, each search sends the words inside the area you dragged and a picture of that area (a JPEG of that part of the tab only), plus your earlier questions in that search for follow-ups. The picture is answered only by AI models that can read images, is processed like an image you attach in the app, and is not saved by the extension or by Keplar. Copy as image keeps the picture on your device. The only thing the extension stores on your device is your API key and that you agreed to Search with Keplar One, in the extension's own storage. It has no analytics, no advertising and no remote code, and it labels a page to Keplar by its host name only. Removing the extension, or its key, stops it; revoke the key in Account to cut off access at once.1a:["$","section","teams-api-extension",{"id":"teams-api-extension","className":"Legal-module__2dCIza__section","aria-labelledby":"teams-api-extension-h","data-still":true,"children":[["$","h2",null,{"id":"teams-api-extension-h","className":"Legal-module__2dCIza__h2","children":[["$","span",null,{"className":"Legal-module__2dCIza__num","aria-hidden":"true","children":"23"}],["$","span",null,{"children":"Team workspaces, API keys and the browser extension (beta)"}],["$","a",null,{"href":"#teams-api-extension","className":"Legal-module__2dCIza__anchor","aria-label":"Link to Team workspaces, API keys and the browser extension (beta)","children":"#"}]]}],[["$","p","0",{"className":"Legal-module__2dCIza__p","children":"$3b"}],["$","p","1",{"className":"Legal-module__2dCIza__p","children":"API keys (beta). A key you create is shown once and stored only as a hash, with its name, scopes, expiry, and counters for requests, credits and last use. Questions sent through the API are processed like questions from a paid account in the app, by the AI model providers described above, and are not saved to your memory or chats. Keys are exported without their hash, and deleting your account deletes your keys. Revoking a key takes effect on the next request."}],["$","p","2",{"className":"Legal-module__2dCIza__p","children":"$3c"}]]]}]
1b:["$","section","international-processing",{"id":"international-processing","className":"Legal-module__2dCIza__section","aria-labelledby":"international-processing-h","data-still":true,"children":[["$","h2",null,{"id":"international-processing-h","className":"Legal-module__2dCIza__h2","children":[["$","span",null,{"className":"Legal-module__2dCIza__num","aria-hidden":"true","children":"24"}],["$","span",null,{"children":"International processing"}],["$","a",null,{"href":"#international-processing","className":"Legal-module__2dCIza__anchor","aria-label":"Link to International processing","children":"#"}]]}],[["$","p","0",{"className":"Legal-module__2dCIza__p","children":"Keplar's hosting, database, email and model providers operate in several countries, including the United States, so your data may be processed outside the country where you live. Keplar does not currently offer region-restricted processing."}]]]}]
1c:["$","section","your-rights",{"id":"your-rights","className":"Legal-module__2dCIza__section","aria-labelledby":"your-rights-h","data-still":true,"children":[["$","h2",null,{"id":"your-rights-h","className":"Legal-module__2dCIza__h2","children":[["$","span",null,{"className":"Legal-module__2dCIza__num","aria-hidden":"true","children":"25"}],["$","span",null,{"children":"Your rights and choices"}],["$","a",null,{"href":"#your-rights","className":"Legal-module__2dCIza__anchor","aria-label":"Link to Your rights and choices","children":"#"}]]}],[["$","p","0",{"className":"Legal-module__2dCIza__p","children":"Depending on where you live, you may have the right to access, correct, export or delete your personal data, to object to or restrict certain processing, and to withdraw consent."}],["$","ul","1",{"className":"Legal-module__2dCIza__list","children":[["$","li","In the app. Delete any chat, study set, slide deck or memory item. Turn memory off. Erase all memory and, optionally, all saved chat history, in Account. In Account > Your data you can download a copy of your data (JSON) and delete your account. Deletion starts a 14-day grace period that you can cancel, after which everything is removed; you can also choose to delete immediately. Deleting removes your chats, memory, sites, images, decks, study sets, business data and sign-in. We keep payment records, usage counters and abuse reports, which hold ids and amounts but no chat, memory or site content, as the law and the integrity of billing and abuse protection require. An active paid subscription must be canceled first.",{"children":[["$","strong",null,{"children":"In the app."}]," ","Delete any chat, study set, slide deck or memory item. Turn memory off. Erase all memory and, optionally, all saved chat history, in Account. In Account > Your data you can download a copy of your data (JSON) and delete your account. Deletion starts a 14-day grace period that you can cancel, after which everything is removed; you can also choose to delete immediately. Deleting removes your chats, memory, sites, images, decks, study sets, business data and sign-in. We keep payment records, usage counters and abuse reports, which hold ids and amounts but no chat, memory or site content, as the law and the integrity of billing and abuse protection require. An active paid subscription must be canceled first."]}],["$","li","By email. Ask us to export or delete your account and its data, or to correct it, at the address below. We may need to confirm it is you. We'll reply as soon as we can and within any time the law requires.",{"children":[["$","strong",null,{"children":"By email."}]," ","Ask us to export or delete your account and its data, or to correct it, at the address below. We may need to confirm it is you. We'll reply as soon as we can and within any time the law requires."]}]]}],["$","p","2",{"className":"Legal-module__2dCIza__p","children":"You can change theme or clear browser storage at any time in your browser."}]]]}]
1d:["$","section","children",{"id":"children","className":"Legal-module__2dCIza__section","aria-labelledby":"children-h","data-still":true,"children":[["$","h2",null,{"id":"children-h","className":"Legal-module__2dCIza__h2","children":[["$","span",null,{"className":"Legal-module__2dCIza__num","aria-hidden":"true","children":"26"}],["$","span",null,{"children":"Children"}],["$","a",null,{"href":"#children","className":"Legal-module__2dCIza__anchor","aria-label":"Link to Children","children":"#"}]]}],[["$","p","0",{"className":"Legal-module__2dCIza__p","children":"Keplar accounts are for people who are at least 13 years old. People under 18 may use Keplar only with the permission of a parent or legal guardian, as the Terms of Service explain. Keplar is not directed at children under 13, and we don't knowingly collect personal data from them. If you are a parent or guardian and believe a child under 13 has given us personal data, email us and we will delete the account and its data. Where the law sets a higher minimum age for consent to data processing, that age applies."}]]]}]
1e:["$","section","changes",{"id":"changes","className":"Legal-module__2dCIza__section","aria-labelledby":"changes-h","data-still":true,"children":[["$","h2",null,{"id":"changes-h","className":"Legal-module__2dCIza__h2","children":[["$","span",null,{"className":"Legal-module__2dCIza__num","aria-hidden":"true","children":"27"}],["$","span",null,{"children":"Changes to this policy"}],["$","a",null,{"href":"#changes","className":"Legal-module__2dCIza__anchor","aria-label":"Link to Changes to this policy","children":"#"}]]}],[["$","p","0",{"className":"Legal-module__2dCIza__p","children":"When this policy changes, the date at the top changes too. If a change is significant, we'll tell you in the app or by email before it takes effect."}]]]}]
