acy Policy Â· Keplar"}],["$","meta","18",{"name":"twitter:description","content":"How Keplar handles your questions, files, memory and account data: what is stored, who processes it, how long it is kept, and the controls you have."}],["$","meta","19",{"name":"twitter:image","content":"https://keplar.one/twitter-image"}],["$","link","20",{"rel":"icon","href":"/favicon.ico?favicon.009k3_0rtixpc.ico","sizes":"48x48","type":"image/x-icon"}],["$","link","21",{"rel":"icon","href":"/icon.svg?icon.1m9g0mkh7qo3m.svg","sizes":"any","type":"image/svg+xml"}],["$","link","22",{"rel":"icon","href":"/icon.png?icon.1_-d0o8tt0bd2.png","sizes":"96x96","type":"image/png"}],["$","link","23",{"rel":"apple-touch-icon","href":"/apple-icon.png?apple-icon.43jvvmhzp2v7l.png","sizes":"180x180","type":"image/png"}],["$","$L43","24",{}]]}]}]}],["$","meta",null,{"name":"next-size-adjust","content":""}]]}]
