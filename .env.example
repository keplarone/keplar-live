# Absolute site URL, no trailing slash. Production default is https://keplar.one.
# For local dev put NEXT_PUBLIC_SITE_URL=http://localhost:3000 in .env.local.
NEXT_PUBLIC_SITE_URL=https://keplar.one
# true only on the real production deployment when not on Vercel (Vercel production is detected).
NEXT_PUBLIC_SITE_INDEXABLE=false
# Optional search-console verification tokens (meta tags render only when set).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ---- Create + Business OS (all optional; each feature says "not set up yet" until its keys are set) ----
# See docs/create.md, docs/business-os.md, docs/architecture-cloud.md.
# Neon Postgres (https://neon.tech). Unset = per-instance file/memory store (plan state then rides on a signed cookie).
DATABASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Inngest (durable jobs + the Business OS agent-schedule cron, docs/business-os.md §7).
# Both unset = schedules run in-process (POST /api/business/agents/schedule,
# `npm run agents:tick`, or KEPLAR_LOCAL_SCHEDULER=1). /api/inngest answers 503.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# 1 = use the local Inngest Dev Server (no keys, unsigned). Local only, never in production.
INNGEST_DEV=
# 1 = without Inngest, tick agent schedules once a minute inside the server process.
KEPLAR_LOCAL_SCHEDULER=
OPENROUTER_API_KEY=
KEPLAR_CODEGEN_MODEL=openrouter/auto
KEPLAR_AGENT_MODEL=openrouter/auto
VERCEL_TEAM_ID=
VERCEL_SANDBOX_TOKEN=
VERCEL_PLATFORM_TOKEN=
VERCEL_PLATFORM_PROJECT_ID=
KEPLAR_USER_CONTENT_DOMAIN=keplar.site
OPENAI_MODERATION_API_KEY=
GOOGLE_WEB_RISK_API_KEY=
KEPLAR_ADMIN_TOKEN=
# 32-byte key (base64) for OAuth token encryption; production uses a KMS-wrapped data key.
KEPLAR_TOKEN_ENC_KEY=
# Seller payments (Stripe Connect, Business OS). Off until STRIPE_SECRET_KEY (sk_/rk_ key of the SAME mode as KEPLAR_STRIPE_MODE)
# and STRIPE_CONNECT_WEBHOOK_SECRET are set; Keplar's own plans use Whop (below).
STRIPE_SECRET_KEY=
# Bank linking (Stripe Financial Connections) on Business > Connectors. Same STRIPE_SECRET_KEY as above
# (rk_ preferred; sk_ also accepted) plus the publishable key from that same Stripe account.
# Does not use STRIPE_CONNECT_WEBHOOK_SECRET. Both keys must match KEPLAR_STRIPE_MODE.
# Read-only: balances and transactions for US banks. Keplar cannot charge the linked account.
STRIPE_PUBLISHABLE_KEY=
# Business OS Connect webhook (/api/business/stripe/webhook): connected-account events
# (Accounts v2, direct charges). Required for Connect.
# Comma-separate several (snapshot "Connected accounts" destination + thin v2 destination).
STRIPE_CONNECT_WEBHOOK_SECRET=
# Live-mode secret(s). Live needs KEPLAR_STRIPE_MODE=live, an sk_/rk_live_ key and this. See docs/business-os.md §8b.
STRIPE_CONNECT_WEBHOOK_SECRET_LIVE=
# test (default) | live. The key must match.
KEPLAR_STRIPE_MODE=test
# 1 = refuse new seller checkouts at once (also: admin page "Pause seller payments").
KEPLAR_PAYMENTS_DISABLED=
KEPLAR_MIN_ORDER_CENTS=50
KEPLAR_MAX_ORDER_CENTS=200000
KEPLAR_APPLICATION_FEE_BPS=0
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
POSTIZ_API_URL=
POSTIZ_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SENTRY_DSN=

# ---- Accounts, protections, billing (docs/accounts-billing.md) ----
# Better Auth. Secret: `openssl rand -base64 32`. URL: public origin (magic links + OAuth callbacks).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://keplar.one
# 1 = no anonymous Free use; every /app call needs a session. Leave unset to let anyone try Free.
KEPLAR_AUTH_REQUIRED=
# 1 = dev tools (outbox page). Never in production.
KEPLAR_DEV_TOOLS=
# Google + Microsoft sign-in (separate OAuth clients from the Gmail/Outlook connectors). A button shows only when
# both of its vars are set. Redirect URIs: <BETTER_AUTH_URL>/api/auth/callback/google and …/callback/microsoft.
# Setup guide: /workspace/keplar-assets/oauth-setup.md. (GOOGLE_SIGNIN_CLIENT_ID/SECRET are still accepted.)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Transactional email (magic links, owner alerts). Unset = dev outbox.
RESEND_API_KEY=
KEPLAR_EMAIL_FROM=Keplar <no-reply@keplar.one>
# Owner alerts (spend cap, payment failures).
KEPLAR_OWNER_EMAIL=team@keplar.one
KEPLAR_ALERT_WEBHOOK_URL=
# Free tier: optional separate OpenRouter key. Unset = OPENROUTER_API_KEY. Free only ever calls $0 ":free" models.
OPENROUTER_API_KEY_FREE=
# Free tier: "deny" excludes free hosts that may train on prompts (fewer free models will work). Default allow.
KEPLAR_FREE_DATA_COLLECTION=
# Global daily spend cap (USD, all plans) and Free-only cap. Reaching either pauses Free and alerts the owner.
KEPLAR_GLOBAL_DAILY_USD_CAP=25
KEPLAR_FREE_DAILY_USD_CAP=5
# Kill switch: 1 = pause Free immediately.
KEPLAR_FREE_PAUSED=
# Kill switch: 1 = ignore Live Research briefs from the Keplar One desktop app (questions answer as plain web questions).
KEPLAR_LIVE_RESEARCH_OFF=
# Keplar plans: Whop (https://whop.com). Plus $45 / Pro $99 per month.
# Checkout stays "Checkout opens soon" until WHOP_API_KEY and WHOP_COMPANY_ID are set.
# Webhook: https://keplar.one/api/webhooks/whop (events: payment.succeeded, membership.activated,
# membership.deactivated, refund.created, dispute.created), Standard Webhooks signature.
WHOP_API_KEY=
WHOP_COMPANY_ID=
WHOP_WEBHOOK_SECRET=
# Keplar Lite ($20/mo shown). Checkout for Lite stays hidden until this Whop plan id is set. Not a secret.
WHOP_PLAN_LITE=
# Limit extensions (one-time credit packs bought when a paid plan hits a limit). Each pack is its OWN one-time Whop plan; no existing plan is
# touched. Unset = that pack is "unavailable" and users never see a Buy button for it. Plan ids are not secrets.
WHOP_EXTENSION_PLAN_SMALL=
WHOP_EXTENSION_PLAN_MEDIUM=
# Credits each pack grants (1 credit = $0.002 of model cost). Defaults 1500 / 4000. Price is set on the Whop plan; PRICE_USD is display only.
KEPLAR_EXTENSION_CREDITS_SMALL=1500
KEPLAR_EXTENSION_CREDITS_MEDIUM=4000
KEPLAR_EXTENSION_PRICE_USD_SMALL=
KEPLAR_EXTENSION_PRICE_USD_MEDIUM=
# Days purchased credits stay valid (default 90, 7-365).
KEPLAR_EXTENSION_VALID_DAYS=90

# Apple In-App Purchase (StoreKit 2) for Keplar One iOS (one.keplar.app).
# ASN V2 webhook: https://keplar.one/api/webhooks/apple  (503 until configured).
# Client verify: POST /api/billing/apple/verify (session required).
# Product IDs: one.keplar.plus.monthly (Plus $45), one.keplar.pro.monthly (Pro $99).
# Root CAs are bundled (public). Set APPLE_BUNDLE_ID (or APPLE_IAP_ENABLED=1) to enable verify/ASN.
APPLE_BUNDLE_ID=one.keplar.app
# Sandbox (default) | Production. Production also needs APPLE_APP_APPLE_ID (numeric App Store Connect app id).
APPLE_ENVIRONMENT=Sandbox
APPLE_APP_APPLE_ID=
# Optional App Store Server API key (Users and Access → Integrations → In-App Purchase).
# Not required for ASN V2 or client JWS verify; needed later for getTransactionInfo / history.
APPLE_ISSUER_ID=
APPLE_KEY_ID=
# PEM contents (with \n) or path. Never commit the .p8.
APPLE_PRIVATE_KEY=
APPLE_PRIVATE_KEY_PATH=
# Legacy shared secret for verifyReceipt (unused with StoreKit 2 / ASN V2; leave empty).
APPLE_APP_SHARED_SECRET=
# 1 = enable OCSP online checks in SignedDataVerifier (can time out on serverless).
APPLE_ONLINE_CHECKS=
# Shortcut: set to 1 to use bundle id one.keplar.app without setting APPLE_BUNDLE_ID.
APPLE_IAP_ENABLED=
# Admin accounts (comma-separated): unlimited Compute with a daily USD safety cap.
KEPLAR_ADMIN_EMAILS=team@keplar.one
KEPLAR_ADMIN_DAILY_USD_CAP=25
# Custom domains for published Create sites (Vercel project domains API). See docs/custom-domains.md.
# Token needs write access to the project's domains. Secret: server only, never NEXT_PUBLIC_.
VERCEL_DOMAINS_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Vercel Cron sends this as "Authorization: Bearer $CRON_SECRET" to /api/cron/domains (background domain re-check).
CRON_SECRET=

# Ops: OpenRouter credit balance check (GET /api/ops/openrouter-balance). Strong random; also accepted as Vercel Cron auth.
# External hourly monitors send Authorization: Bearer $OPS_CHECK_SECRET. Never commit the real value.
OPS_CHECK_SECRET=
# Optional OpenRouter management key for GET /api/v1/credits (preferred over OPENROUTER_API_KEY when set).
OPENROUTER_MANAGEMENT_KEY=
# Fallback ops alert recipient when KEPLAR_OWNER_EMAIL is unset (defaults to team@keplar.one).
ADMIN_EMAIL=
